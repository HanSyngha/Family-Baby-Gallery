# OAuth (Kakao 필수, Naver 선택)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# JWT 시크릿 (랜덤 문자열로 변경)
JWT_SECRET=change-this-to-random-string

# 서비스 URL (OAuth 콜백에 사용)
BASE_URL=https://your-domain:2280

# Web Push (VAPID 키 - npx web-push generate-vapid-keys 로 생성)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
